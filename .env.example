# STS2-AUTOTEST Environment Variables
# Copy this file to .env and customize values.
# These override sts2-autotest.yaml but are overridden by CLI arguments.
# Use __ (double underscore) as section separator.

# Framework
# STS2_FRAMEWORK__LOG_LEVEL=INFO
# STS2_FRAMEWORK__SCREENSHOT_DIR=./screenshots
# STS2_FRAMEWORK__EVIDENCE_DIR=./evidence
# STS2_FRAMEWORK__EVIDENCE_RETENTION=20

# Adapter: CLI (STS2-Cli-Mod)
# STS2_ADAPTER__CLI__ENABLED=true
# STS2_ADAPTER__CLI__CLI_PATH=sts2
# STS2_ADAPTER__CLI__TIMEOUT=30.0

# Adapter: Agent (Beta, disabled by default)
# STS2_ADAPTER__AGENT__ENABLED=false
# STS2_ADAPTER__AGENT__ENDPOINT=http://127.0.0.1:8080
# STS2_ADAPTER__AGENT__TIMEOUT=30.0

# Execution
# STS2_EXECUTION__GAME_TIMEOUT=60.0
# STS2_EXECUTION__GAME_STARTUP_TIMEOUT=60.0
# STS2_EXECUTION__MAX_RETRIES=3
# STS2_EXECUTION__PARALLEL=false

# State Machine
# STS2_STATE_MACHINE__TRANSITION_TIMEOUT=10.0
# STS2_STATE_MACHINE__POLL_INTERVAL=0.5

# Notifications (B13)
# STS2_NOTIFICATIONS__ENABLED=true
# STS2_NOTIFICATIONS__ON_SUCCESS=true
# STS2_NOTIFICATIONS__ON_FAILURE=true
# STS2_NOTIFICATIONS__ON_CRASH=true

# Project Extension（MOD 项目专属规则，平台默认全部为空）
# 卡牌规格写法到运行时 ID 前缀的映射：alias:PREFIX[,alias2:PREFIX2]
# STS2_PROJECT__CARD_ID_PREFIXES=mymod:MYMOD-
# set_seed 动作对应的调试控制台命令模板（{seed} 为占位符）
# STS2_PROJECT__SEED_COMMAND_TEMPLATE=mymod_seed {seed}
# NL 规格角色别名映射：名称:运行时ID[,名称2:运行时ID2]
# STS2_PROJECT__CHARACTER_ALIASES=MyChar:MYMOD-MYCHAR
