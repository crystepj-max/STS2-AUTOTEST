# Generated Makefile
# (meta build system like autotools,
# can automatically generate from config.status script
# (which is called by configure script))
Makefile

# Python bytecode
__pycache__/
*.pyc
*.pyo
.venv/

# 本地环境配置（密钥与本地配置只放 .env，模板 .env.example 入库；
# 门禁脚本：scripts/check-env-gitignore.sh）
.env
.env.*
!.env.example

.pytest_cache/
.mypy_cache/
.import_linter_cache/
.pytest-tmp*/
.worktrees/

# BMad
_bmad/
_bmad-output/

# Claude Code local config（本地配置忽略，但共享技能目录入库）
.claude/*
!.claude/skills/
!.claude/skills/**
# 技能目录重忽略环境文件（否定规则会放行嵌套 .env，须按环境文件门禁重新忽略）
.claude/skills/**/.env
.claude/skills/**/.env.*

# Codex local config
.agents/

# Editor local config
.vscode/

# Local external downloads and runtime evidence
.external/
tests/output/

# Superpowers brainstorming artifacts
.superpowers/

# Local agent collaboration protocol and handoffs
.agent-collab/

# 本地项目登记（机器相关的项目路径，不随平台分发）
sts2-autotest.yaml
sts2-autotest.yml

# CodeGraph 本地索引（代码地图缓存，不入库）
.codegraph/

# Agent run 产物（开发工作流留痕，不入库）
.agent-runs/
